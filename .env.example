# ---------------------------------------------------------------------------
# Mobile automation framework — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored; never commit it.
# Anything whose value is a credential should also be listed in
# SECRET_ENV_VARS (test/helpers/logMasking.ts) so it never reaches a log file.
# ---------------------------------------------------------------------------

# === App under test ========================================================
# The single place the app's identity is configured — see config/app.config.ts.
APP_NAME=MyApp
IOS_BUNDLE_ID=com.example.myapp
ANDROID_APP_PACKAGE=com.example.myapp
ANDROID_APP_ACTIVITY=com.example.myapp.MainActivity

# === iOS device / simulator ================================================
IOS_DEVICE_NAME=your_ios_device_name
IOS_UDID=your_ios_udid
IOS_PLATFORM_VERSION=18.7

# Path to the build under test. Left unset, the config falls back to
# apps/app.ipa, then apps/<APP_NAME>.app, then launches whatever is already
# installed by bundle id.
#IOS_APP_PATH=./apps/app.ipa

# Keep app data between sessions (skips a reinstall).
#IOS_NO_RESET=true

# XCUITest handles every system alert itself. Turn it OFF (=false) only when a
# spec must decide per alert — see test/helpers/alerts.ts for what that costs.
# Note the cloud config inverts this default: there it is OFF unless set to true.
#IOS_AUTO_ACCEPT_ALERTS=false

# === iOS real device: WebDriverAgent signing ===============================
# Required for a real device. Personal Team ids work.
#IOS_XCODE_ORG_ID=your_apple_developer_team_id
#IOS_XCODE_SIGNING_ID=Apple Development

# Launch the already-installed WDA runner instead of driving it through
# xcodebuild. Strongly recommended locally: with it, a failed session no longer
# makes Appium uninstall the runner, which is what otherwise costs a manual
# re-trust on the phone before the next run can start.
#IOS_USE_PREINSTALLED_WDA=true
#IOS_UPDATED_WDA_BUNDLE_ID=com.wda.<team_id>.WebDriverAgentRunner
# Only if Appium should (re)install the runner each session.
#IOS_PREBUILT_WDA_PATH=/path/to/WebDriverAgentRunner-Runner.app
# Skip the WDA build (it must already be built).
#IOS_USE_PREBUILT_WDA=true
# Surface xcodebuild errors in the Appium log when a WDA build fails.
#SHOW_XCODE_LOG=true

# === iOS simulator runs (scripts/run-ios-sim.sh) ===========================
# Read before .env loads — export these in your shell, not here:
#   IOS_SIM_UDID     pick a specific booted simulator when several are booted
#   APP_SOURCE_DIR   app repo path, for scripts/refresh-ios-sim-app.sh
#   APP_SCHEME       Xcode scheme to build

# === Android ===============================================================
#ANDROID_DEVICE_NAME=emulator-5554
#ANDROID_UDID=emulator-5554
#ANDROID_PLATFORM_VERSION=13.0
#ANDROID_APP_PATH=./apps/app.apk
# Test whatever is already installed instead of installing ANDROID_APP_PATH.
#ANDROID_USE_INSTALLED_APP=true
#ANDROID_NO_RESET=true
# Grant runtime permissions at install, skipping the dialogs. Leave off when the
# permission flow is itself under test.
#ANDROID_AUTO_GRANT_PERMISSIONS=true

# === In-app purchase (iOS StoreKit sandbox) ================================
# Create a sandbox tester at https://appstoreconnect.apple.com
#   -> Users and Access -> Sandbox Testers
# SECRET — both lines. The account is half of a login, so it is masked like the
# password; see test/helpers/logMasking.ts.
#IOS_SANDBOX_ACCOUNT=your_sandbox_apple_id
#IOS_SANDBOX_APPLE_PAY_PASSWORD=your_sandbox_apple_id_password
# A simulator has no sandbox; it only knows its ordinary Apple Account.
# Also SECRET — the account is half of a login, so it is masked too.
#IOS_SIM_APPLE_ID=your_simulator_apple_id
#IOS_SIM_APPLE_PASSWORD=your_simulator_apple_password
# Screenshot + page-source diagnostics around the blind Apple Pay taps.
# Turn on to re-measure coordinates on a new device size.
#APPLEPAY_DEBUG=true

# === Real-device cloud (LambdaTest / TestMu AI) ============================
# Credentials: dashboard -> Profile -> Access Key.
#CLOUD_USERNAME=your_cloud_username
#CLOUD_ACCESS_KEY=your_cloud_access_key
#CLOUD_HOSTNAME=mobile-hub.lambdatest.com
# Set after uploading — `npm run cloud:upload-ios-app` prints it.
#CLOUD_APP_ID=lt://your_uploaded_app_id
#CLOUD_IOS_DEVICE_NAME=iPhone 15 Pro
#CLOUD_IOS_PLATFORM_VERSION=18
#CLOUD_IOS_UDID=your_private_device_udid
#CLOUD_PRIVATE_CLOUD=true
#CLOUD_RESIGN_APP=false
#CLOUD_BUILD_NAME=local
#CLOUD_IOS_APP_PATH=./apps/app.ipa
# Override only for a non-LambdaTest hub.
#CLOUD_UPLOAD_URL=https://manual-api.lambdatest.com/app/upload/realDevice

# === Test data =============================================================
# Whatever your app's flows need. Keep credentials out of git and list any
# genuine secret in SECRET_ENV_VARS (test/helpers/logMasking.ts).
#TEST_PHONE_NUMBER=
#TEST_OTP=
#TEST_USERNAME=
#TEST_PASSWORD=

# === Appium MCP (live-device inspection) ===================================
# The official server (github.com/appium/appium-mcp) is wired up in .mcp.json and
# takes its capabilities from the iOS/Android values above — nothing to repeat
# here. See CLAUDE.md, "Inspecting a live device".
# Install the binary on session create instead of attaching to what is already
# on the device. Off by default: reinstalling wipes the state you wanted to see.
#MCP_INSTALL_APP=true
# Pin a different server version than scripts/appium-mcp.sh defaults to.
#APPIUM_MCP_VERSION=1.94.0

# === Logging and reporting =================================================
#WDIO_LOG_LEVEL=info
#APPIUM_LOG_LEVEL=info
# Where scripts/summarize-allure.ts reads results from.
#ALLURE_RESULTS_DIR=allure-results
# Comma-separated extra env var names whose values must be masked in logs.
#EXTRA_SECRET_ENV_VARS=MY_OTHER_SECRET
