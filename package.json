{
  "name": "mobile-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Appium + WebdriverIO mobile E2E automation framework (iOS + Android). App-agnostic core: configs, page-object base, helpers, tooling.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "@wdio/allure-reporter": "^9.30.1",
    "@wdio/appium-service": "^9.30.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/junit-reporter": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "allure-commandline": "^2.43.0",
    "appium": "^3.2.0",
    "appium-uiautomator2-driver": "^7.1.0",
    "appium-xcuitest-driver": "^10.24.1",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "undici": "^6.28.0"
  },
  "overrides": {
    "axios": "1.19.0"
  },
  "scripts": {
    "wdio:ios": "wdio run ./wdio.ios.conf.ts",
    "wdio:ios:sim": "./scripts/run-ios-sim.sh",
    "wdio:ios:cloud": "wdio run ./wdio.ios.cloud.conf.ts",
    "wdio:android": "wdio run ./wdio.android.conf.ts",
    "refresh:ios-sim-app": "./scripts/refresh-ios-sim-app.sh",
    "cloud:upload-ios-app": "tsx scripts/upload-ios-app-to-cloud.ts",
    "preflight": "tsx scripts/preflight.ts",
    "mcp:capabilities": "tsx scripts/write-mcp-capabilities.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "doctor:ios": "appium driver doctor xcuitest",
    "doctor:android": "appium driver doctor uiautomator2",
    "appium:drivers": "appium driver list --installed",
    "doctor": "npm run appium:drivers && npm run doctor:ios && npm run doctor:android",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:clean": "rm -rf allure-results allure-report test-results",
    "summary": "tsx scripts/summarize-allure.ts"
  }
}
